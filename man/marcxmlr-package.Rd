\name{marcxmlr-package}
\alias{marcxmlr}
\alias{marcxmlr-package}
\docType{package}
\title{marcxmlr: Faithful and Scalable MARCXML Parsing}
\description{
Parse MARC21 XML into a canonical tidy long representation while preserving
repeated structures and source order. Use \code{read_marcxml()} for in-memory
work and \code{marcxml_to_parquet()} for bounded-memory conversion to a
disk-backed Parquet dataset.
}
